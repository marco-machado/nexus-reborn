+.viewer { display: grid; grid-template: 82px minmax(0, 1fr) 34px / 300px minmax(0, 1fr); height: 100dvh; min-height: 640px; }
+.viewer-header { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; padding: 0 26px; border-bottom: 1px solid var(--line); }
+.eyebrow, .field { font-size: 10px; letter-spacing: 0.14em; color: var(--ink-dim); }
+h1 { margin: 6px 0 0; font-size: 21px; font-weight: 500; letter-spacing: -0.03em; }
+h2 { margin: 9px 0 5px; font-size: 32px; font-weight: 500; letter-spacing: -0.04em; color: var(--teal); }
+.backend { color: var(--teal); font-size: 11px; border: 1px solid var(--line); padding: 8px 12px; }
+.inspector { overflow-y: auto; border-right: 1px solid var(--line); background: var(--bg-panel-solid); }
+.inspector section { padding: 19px 23px; border-bottom: 1px solid var(--line); }
+.asset-description { margin: 0; font-size: 11px; }
+.source { color: var(--ink-dim); font-size: 10px; line-height: 1.7; margin: 12px 0 0; overflow-wrap: anywhere; }
+.source code { color: var(--ink); font-family: inherit; }
+.field { display: block; margin-bottom: 10px; text-transform: uppercase; }
+button, select { font: inherit; font-size: 11px; color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 2px; padding: 9px 10px; }
+button { cursor: pointer; }
+button:hover, button[aria-pressed="true"] { color: var(--teal); border-color: var(--teal); background: var(--bg-inset); }
+button:focus-visible, select:focus-visible, input:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }
+select { width: 100%; }
+.view-buttons { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; }
+.toggles { display: grid; gap: 10px; margin-top: 15px; }
+.toggles label { display: flex; align-items: center; gap: 8px; font-size: 11px; cursor: pointer; }
+input[type="checkbox"] { accent-color: var(--teal); margin: 0; width: 13px; height: 13px; }
+.exposure-label { display: flex; justify-content: space-between; margin-top: 17px; margin-bottom: 4px; }
+input[type="range"] { width: 100%; margin: 4px 0 12px; accent-color: var(--teal); }
+.reset { width: 100%; }
+dl { margin: 0; display: grid; grid-template-columns: 1fr auto; gap: 8px; font-size: 11px; }
+dt { color: var(--ink-dim); } dd { margin: 0; text-align: right; }
+.viewport { position: relative; min-width: 0; min-height: 0; overflow: hidden; }
+.viewport canvas { display: block; width: 100%; height: 100%; touch-action: none; }
+.viewport-label { position: absolute; top: 24px; left: 26px; display: flex; align-items: center; gap: 9px; color: var(--ink); font-size: 10px; letter-spacing: 0.12em; pointer-events: none; }
+.status-dot { width: 5px; height: 5px; background: var(--teal); border-radius: 50%; }
+.viewport-help { position: absolute; bottom: 23px; left: 20px; right: 20px; text-align: center; color: var(--ink-dim); font-size: 10px; pointer-events: none; }
+.viewport-help span { margin: 0 9px; }
+.loading { position: absolute; inset: 0; display: grid; place-content: center; padding: 30px; text-align: center; color: var(--amber); background: var(--bg); }
+.loading[hidden] { display: none; }
+.viewer-footer { grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: center; padding: 0 23px; border-top: 1px solid var(--line); color: var(--ink-dim); font-size: 9px; letter-spacing: 0.08em; }
+@media (max-height: 850px) {
+  .inspector section { padding: 9px 18px; }
+  h2 { font-size: 26px; margin: 5px 0; }
+  .source { font-size: 9px; margin-top: 6px; line-height: 1.5; }
+  .field { margin-bottom: 8px; }
+  button, select { padding: 7px 10px; }
+  .toggles { gap: 8px; margin-top: 12px; }
+  .view-buttons + .toggles { grid-template-columns: 1fr 1fr; }
+  .exposure-label { margin-top: 12px; margin-bottom: 4px; }
+  input[type="range"] { margin-bottom: 8px; }
+  dl { gap: 4px; }
+}
+@media (max-width: 760px) { .viewer { grid-template-columns: 235px minmax(280px, 1fr); } .inspector section { padding: 16px; } .viewer-footer span:last-child { display: none; } }
