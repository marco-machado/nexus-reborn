+    vipRingMat: new THREE.MeshBasicMaterial({
+      color: '#9be8ff',
+      transparent: true,
+      opacity: 0.55,
+      side: THREE.DoubleSide,
+      depthWrite: false,
+    }),
+    deviceGeom: new THREE.BoxGeometry(0.9, 1.0, 0.9),
+    deviceCoreGeom: new THREE.BoxGeometry(0.55, 0.22, 0.55),
+    deviceBody: std('#1c2427', 0.9),
